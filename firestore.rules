rules_version = '2';

// Khalihan — Firestore rules (8 Oct 2026; Kendra 12 Oct; price history server-only 19 Oct; free Plus gift codes 1 Nov 2026; owner stats 10 Nov 2026; Plus on Play 16 Nov 2026; free week, plan counts and who sees full numbers 23 Nov 2026).
//
// Who is who:
//   • Farmers: the app. Prices, schemes, calendar and offers are open to
//     everyone to read (only the server writes prices); a farmer's own account (users/{uid}) only to that farmer.
//   • Staff: people in staff/{email} (role "owner" or "staff"), logged in to
//     Khalihan Admin with Google. Only the owner adds staff or changes
//     feature switches.
//   • The daily server (GitHub Actions) uses a service account, which these
//     rules don't apply to.
//
// Deploy: from this folder, `firebase deploy --only firestore:rules`
// (see admin/README.md). Copy the old rules from the console first.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // A farmer's phone login has no email: then this is ''.
    function staffEmail() {
      return signedIn() && ('email' in request.auth.token)
        && request.auth.token.get('email_verified', false) == true
        ? request.auth.token.email.lower() : '';
    }
    function isStaff() {
      return staffEmail() != ''
        && exists(/databases/$(database)/documents/staff/$(staffEmail()));
    }
    function isOwner() {
      return isStaff()
        && get(/databases/$(database)/documents/staff/$(staffEmail())).data.role == 'owner';
    }
    function phoneOfLogin() {
      return request.auth.token.get('phone_number', '');
    }
    // Farmers' full mobile numbers and accounts (owner, 23 Nov 2026: "pura
    // mobile number sirf admin dekhe, aur technical team jise main access
    // doon"): the owner, and staff the owner allowed in Admin → Team
    // (staff/{email}.phones == true). Other staff do not read accounts.
    function canSeePhones() {
      return isOwner()
        || (isStaff()
            && get(/databases/$(database)/documents/staff/$(staffEmail())).data.get('phones', false) == true);
    }

    // ── prices: the server writes; phones read, and keep a backup copy ─
    // Which crops each district trades (last 30 days), server-written,
    // public prices only (26 Oct 2026).
    match /popular/{scope} {
      allow read: if true;
      allow write: if false;
    }
    match /live/{scope} {
      allow read: if true;
      allow write: if false;
      match /parts/{part} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /prices/{scope}/days/{day} {
      allow read: if true;
      // Only the server files a day's averages (19 Oct 2026). Phones used to
      // keep a backup copy, but anyone holding the app's public config could
      // then write made-up prices into the history — and since the collector
      // brings every state, the server's copy is complete anyway. Old app
      // versions still try; their write is refused quietly (try/catch).
      allow write: if false;
    }

    match /mandi_days/{state} {
      allow read: if true;
      allow write: if false;
    }

    // ── how the daily job went, per state (the server writes; Admin reads)
    match /status/{doc} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ── content the app reads; staff change it from Khalihan Admin ─────
    match /config/{doc} {
      allow read: if true;
      // Offers: any staff member. Feature switches, the notice (config/app
      // .notice), schemes, calendar: owner.
      allow write: if (doc == 'buy_offers' && isStaff()) || isOwner();
    }

    // ── "सुझाव दें" ────────────────────────────────────────────────────
    // App 1.0.10 ("Message to the Khalihan team", owner 18 Nov 2026 — Admin
    // rework Part 1): the kind of message, and — only if the farmer turns each
    // on while sending — his name, a small profile photo (JPEG as text, a few
    // KB), his mobile number and phone details (`info`: model, Android, network,
    // notifications; `trail`: what went wrong in the app this week, as short
    // codes). `dev` is the phone's random ID, where the reply goes (inbox/);
    // `en`, the phone's English translation for the team.
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(
            ['text', 'state', 'district', 'lang', 'app', 'at', 'kind', 'en', 'name', 'phone', 'photo', 'dev', 'info', 'trail', 'reply_to'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.at == request.time
        && request.resource.data.get('kind', 'suggestion') in ['problem', 'suggestion', 'praise', 'ai_wrong']
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() <= 60
        && request.resource.data.get('phone', '') is string
        && (request.resource.data.get('phone', '') == '' || request.resource.data.get('phone', '').matches('^[6-9][0-9]{9}$'))
        && request.resource.data.get('photo', '') is string
        && request.resource.data.get('photo', '').size() <= 24000
        && request.resource.data.get('dev', 'aaaaaaaaaaaaaaaaaaaa').matches('^[a-z0-9]{20}$')
        && request.resource.data.get('info', {}) is map
        && request.resource.data.get('info', {}).size() <= 12
        && request.resource.data.get('trail', []) is list
        && request.resource.data.get('trail', []).size() <= 40
        && request.resource.data.get('reply_to', '') is string
        && request.resource.data.get('reply_to', '').size() <= 40
        && request.resource.data.get('en', '') is string
        && request.resource.data.get('en', '').size() <= 1500;
      allow read: if isStaff();
      // done_at (Admin 1.30): when it was answered, for the morning summary.
      // en, replied_at, reply_by (Admin 1.31): the English the team reads, and
      // when and by whom the farmer got a reply in the app.
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'note', 'by', 'done_at', 'en', 'replied_at', 'reply_by']);
      allow delete: if isOwner();
    }

    // ── The team's replies, inside the app (app 1.0.10, Admin 1.31) ─────
    // inbox/{dev}: the phone's random ID → where its replies are sent (the
    // phone's notification token). The phone writes it only when it sends a
    // message; only the team reads it. inbox/{dev}/replies: the team writes;
    // the phone reads its own by its random ID (like a Kendra order by its
    // id) and may only mark one seen or say if it helped.
    match /inbox/{dev} {
      allow create, update: if dev.matches('^[a-z0-9]{20}$')
        && request.resource.data.keys().hasOnly(['token', 'lang', 'app', 'at'])
        && request.resource.data.token is string
        && request.resource.data.token.size() < 600
        && request.resource.data.lang is string
        && request.resource.data.lang.size() <= 8
        && request.resource.data.app is string
        && request.resource.data.app.size() <= 20
        && request.resource.data.at == request.time;
      allow read: if isStaff();
      allow delete: if isOwner();
      match /replies/{id} {
        allow get, list: if dev.matches('^[a-z0-9]{20}$');
        allow create: if isStaff()
          && request.resource.data.keys().hasOnly(['text', 'shown', 'lang', 'for', 'by', 'by_name', 'at'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.shown is string
          && request.resource.data.shown.size() <= 2000
          && request.resource.data.by == staffEmail()
          && request.resource.data.at == request.time;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helped', 'seen'])
          && request.resource.data.get('helped', true) is bool
          && request.resource.data.get('seen', true) is bool;
        allow delete: if isOwner();
      }
    }

    // ── "My state isn't in the list" (app v1.0.4+, 20 Oct 2026) ─────────
    // One document per phone, under a random id the phone made: only the
    // state, the app version and the time — no name, number or place.
    // Admin counts them per state to choose the next state to open.
    match /waiting/{id} {
      allow create, update: if id.matches('^[a-z0-9]{20}$')
        && request.resource.data.keys().hasOnly(['s', 'app', 'at'])
        && request.resource.data.s is string
        && request.resource.data.s.size() > 0
        && request.resource.data.s.size() <= 40
        && request.resource.data.app is string
        && request.resource.data.app.size() <= 20
        && request.resource.data.at == request.time;
      allow read: if isStaff();
      allow delete: if isOwner();
    }

    // ── "Khalihan ko becho" ────────────────────────────────────────────
    match /sell_requests/{id} {
      // Logged in: the request carries the uid and the OTP-checked number.
      // Login switched off from Admin: the old way, a typed 10-digit number.
      allow create: if request.resource.data.keys().hasOnly(
            ['offer', 'crop', 'qty', 'price', 'village', 'district', 'name', 'phone', 'lang', 'app', 'at', 'uid', 'status'])
        && request.resource.data.get('status', 'new') == 'new'
        && request.resource.data.qty is number
        && request.resource.data.qty > 0
        && request.resource.data.qty <= 10000
        && request.resource.data.village is string
        && request.resource.data.village.size() <= 60
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.phone is string
        && request.resource.data.at == request.time
        && (
          (signedIn()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.phone == phoneOfLogin())
          ||
          (!('uid' in request.resource.data)
            && request.resource.data.phone.matches('^[6-9][0-9]{9}$'))
        );
      // "मेरी बिक्री": a farmer reads only their own.
      allow read: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);
      // Staff move it along: Nayi → Call kiya → Deal pakki → Maal uthaya → Paisa diya.
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'history', 'assigned', 'note', 'updated', 'final_price', 'final_qty']);
      allow delete: if isOwner();
    }

    // ── a farmer's account ─────────────────────────────────────────────
    // 23 Nov 2026: the village and taluka (the team's view by area), and
    // when the farmer said "I agree" and whether he wants offers (the free
    // week's details page). Read: the farmer, the owner and staff allowed
    // to see numbers.
    match /users/{uid} {
      allow read: if isSelf(uid) || canSeePhones();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(
             ['phone', 'name', 'state', 'district', 'lang', 'app', 'crops', 'seen', 'created', 'data',
              'taluka', 'village', 'consent', 'offers'])
        && request.resource.data.phone == phoneOfLogin()
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.data is map
        && request.resource.data.get('taluka', '') is string
        && request.resource.data.get('taluka', '').size() <= 80
        && request.resource.data.get('village', '') is string
        && request.resource.data.get('village', '').size() <= 80
        && (!('consent' in request.resource.data) || request.resource.data.consent is timestamp)
        && request.resource.data.get('offers', false) is bool;
      allow delete: if isSelf(uid) || isOwner();
    }

    // A bought plan's forms and papers (owner, 23 Nov 2026): one document
    // per plan and its end date (m1_20261223 …), counted by the farmer's
    // phone — only up, one at a time; the farmer cannot lower or delete
    // it. Read by the farmer and the team allowed to see accounts.
    match /users/{uid}/use/{period} {
      allow read: if isSelf(uid) || canSeePhones();
      allow create: if isSelf(uid)
        && period.matches('^m(1|3|6|12)_[0-9]{8}$')
        && request.resource.data.keys().hasOnly(['forms', 'docs', 'at'])
        && request.resource.data.get('forms', 0) is int
        && request.resource.data.get('forms', 0) >= 0
        && request.resource.data.get('forms', 0) <= 1
        && request.resource.data.get('docs', 0) is int
        && request.resource.data.get('docs', 0) >= 0
        && request.resource.data.get('docs', 0) <= 1
        && request.resource.data.at == request.time;
      allow update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['forms', 'docs', 'at'])
        && request.resource.data.get('forms', 0) is int
        && request.resource.data.get('forms', 0) >= resource.data.get('forms', 0)
        && request.resource.data.get('forms', 0) <= resource.data.get('forms', 0) + 1
        && request.resource.data.get('docs', 0) is int
        && request.resource.data.get('docs', 0) >= resource.data.get('docs', 0)
        && request.resource.data.get('docs', 0) <= resource.data.get('docs', 0) + 1
        && request.resource.data.at == request.time;
      allow delete: if isOwner();
    }

    // Khalihan AI's use, counted with the account (review of 23 Nov 2026:
    // the count lived on the phone only, so clearing the app's data or
    // installing it again gave a fresh share). One document for the day
    // (d20261123) and one for the month (m202611), India's date by OUR
    // clock — a phone whose date is moved cannot open another day's
    // document. Counts only, and only upward: one use at a time (Kaptan's
    // voice: up to 10 minutes of seconds). Nothing about what was asked.
    function aiDayId() {
      let n = request.time + duration.value(330, 'm');
      return 'd' + string(n.year())
        + (n.month() < 10 ? '0' : '') + string(n.month())
        + (n.day() < 10 ? '0' : '') + string(n.day());
    }
    function aiMonthId() {
      let n = request.time + duration.value(330, 'm');
      return 'm' + string(n.year()) + (n.month() < 10 ? '0' : '') + string(n.month());
    }
    function aiFirst(k, most) {
      return request.resource.data.get(k, 0) is number
        && request.resource.data.get(k, 0) >= 0
        && request.resource.data.get(k, 0) <= most;
    }
    function aiMore(k, most) {
      return request.resource.data.get(k, 0) is number
        && request.resource.data.get(k, 0) >= resource.data.get(k, 0)
        && request.resource.data.get(k, 0) <= resource.data.get(k, 0) + most;
    }
    // (Not under …/ai/, which holds the farmer's own records and is his to
    // delete: a count he could delete would be no count.)
    match /users/{uid}/aiuse/{period} {
      allow read: if isSelf(uid) || canSeePhones();
      allow create: if isSelf(uid)
        && (period == aiDayId() || period == aiMonthId())
        && request.resource.data.keys().hasOnly(['ask', 'open', 'deep', 'photo', 'voice', 'page', 'help', 'at'])
        && aiFirst('ask', 1) && aiFirst('open', 1) && aiFirst('deep', 1) && aiFirst('photo', 1)
        && aiFirst('page', 1) && aiFirst('help', 1) && aiFirst('voice', 600)
        && request.resource.data.at == request.time;
      allow update: if isSelf(uid)
        && (period == aiDayId() || period == aiMonthId())
        && request.resource.data.keys().hasOnly(['ask', 'open', 'deep', 'photo', 'voice', 'page', 'help', 'at'])
        && aiMore('ask', 1) && aiMore('open', 1) && aiMore('deep', 1) && aiMore('photo', 1)
        && aiMore('page', 1) && aiMore('help', 1) && aiMore('voice', 600)
        && request.resource.data.at == request.time;
      allow delete: if isOwner();
    }

    // The free week (owner, 23 Nov 2026: seven days of Khalihan Pro at
    // login, no payment, no auto-pay; "Suresh ne 7 days use kar liya,
    // khatam"). One per mobile number — this document, named by the
    // number — and one per phone: trial_devices/{hash of the phone's
    // Android id for our app}, written in the same batch. Its start is
    // the server's clock, never the phone's; the week ends seven days on,
    // or at `end` when the owner changes it in Admin. The farmer's phone
    // counts the week's forms and papers here — only up, one at a time.
    match /plus_trials/{phone} {
      allow get: if signedIn() && phone == phoneOfLogin();
      allow read: if canSeePhones();
      allow create: if signedIn() && phone == phoneOfLogin()
        && request.resource.data.keys().hasOnly(['uid', 'start', 'device', 'app', 'forms', 'docs'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.start == request.time
        && request.resource.data.device is string
        && request.resource.data.device.matches('^[a-f0-9]{64}$')
        && request.resource.data.app is string
        && request.resource.data.app.size() <= 20
        && request.resource.data.forms == 0
        && request.resource.data.docs == 0
        && !exists(/databases/$(database)/documents/trial_devices/$(request.resource.data.device))
        && existsAfter(/databases/$(database)/documents/trial_devices/$(request.resource.data.device));
      allow update: if (signedIn() && phone == phoneOfLogin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['forms', 'docs'])
          && request.resource.data.forms is int
          && request.resource.data.forms >= resource.data.forms
          && request.resource.data.forms <= resource.data.forms + 1
          && request.resource.data.docs is int
          && request.resource.data.docs >= resource.data.docs
          && request.resource.data.docs <= resource.data.docs + 1)
        || (isOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['end', 'note', 'by'])
          && request.resource.data.get('end', request.time) is timestamp);
      allow delete: if isOwner();
    }
    match /trial_devices/{device} {
      allow create: if signedIn()
        && device.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time
        && getAfter(/databases/$(database)/documents/plus_trials/$(phoneOfLogin())).data.device == device;
      allow read, delete: if isOwner();
    }

    // Khalihan AI's records in the farmer's account (v1.0.9 Step 3, switch
    // ai_account): My chats, Applied forms, My documents, My form details
    // (21 Nov 2026: answers given to forms and site user names — never
    // Aadhaar or PAN, which stay in the phone's locked store) — one document
    // each, the list as text. Only that farmer reads or writes them; staff
    // do not (private papers). Their photos and papers are in Cloud Storage
    // (storage.rules), likewise.
    match /users/{uid}/ai/{part} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && part in ['chats', 'applied', 'docs', 'form']
        && request.resource.data.keys().hasOnly(['items', 'gone', 'n', 'at'])
        && request.resource.data.items is string
        && request.resource.data.items.size() <= 1000000
        && request.resource.data.gone is string
        && request.resource.data.gone.size() <= 40000
        && request.resource.data.n is int
        && request.resource.data.at == request.time;
    }

    // Khalihan Plus bought on Google Play (v1.0.9, owner 16 Nov 2026).
    // Only our server (plus-verify, after asking Google) writes the
    // farmer's plan here; the phone reads its own, nobody can write it from
    // a phone. The owner reads it for Admin's members count.
    match /users/{uid}/plus/{doc} {
      allow read: if isSelf(uid) || isOwner();
      allow write: if false;
    }
    // Admin's members count: every farmer's plan at once (owner only).
    match /{path=**}/plus/{doc} {
      allow read: if isOwner();
    }

    match /deletion_requests/{uid} {
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['phone', 'at', 'done', 'by'])
        && request.resource.data.at == request.time;
      allow read: if isStaff();
      // Staff mark it done after clearing sell requests and WhatsApp copies.
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'by']);
      allow delete: if isOwner();
    }

    // ── Khalihan's own money: owner only ───────────────────────────────
    // What the processor pays and what a deal cost us. Kept apart from
    // sell_requests (a farmer can read their own) and from the offers (every
    // phone reads them), so no farmer ever sees our rates or margin.
    match /deal_money/{id} {
      allow read, write: if isOwner();
    }
    match /offer_money/{id} {
      allow read, write: if isOwner();
    }

    // ── Khalihan Kendra (seed & fertiliser shop) ───────────────────────
    // The shop's facts, Home card and goods: every phone reads them; staff
    // change them from Khalihan Admin. Pesticides are never listed (the app
    // also refuses any category it doesn't know).
    match /kendra/{doc} {
      allow read: if true;
      allow write: if isStaff() && doc in ['info', 'home_card'];
    }
    match /kendra_products/{id} {
      allow read: if true;
      allow write: if isStaff()
        && request.resource.data.cat in ['seed', 'fert', 'organic', 'micro', 'tools'];
      allow delete: if isStaff();
    }
    // What we pay for each product: owner only, never where phones read.
    match /kendra_cost/{id} {
      allow read, write: if isOwner();
    }

    // A farmer's reservation: pick up at the Kendra, pay there. No login
    // needed; the phone keeps the order's id and reads it back by id only
    // (nobody can list orders but staff).
    match /kendra_orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(
            ['code', 'items', 'total', 'day', 'slot', 'name', 'phone', 'village', 'district', 'uid', 'lang', 'app', 'at', 'status'])
        && request.resource.data.status == 'new'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 20
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total < 10000000
        && request.resource.data.day is string
        && request.resource.data.day.size() == 10
        && request.resource.data.slot in ['m', 'a', 'e']
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 12
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.village is string
        && request.resource.data.village.size() > 0
        && request.resource.data.village.size() <= 60
        && request.resource.data.phone is string
        && request.resource.data.at == request.time
        && (
          (signedIn()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.phone == phoneOfLogin())
          ||
          (!('uid' in request.resource.data)
            && request.resource.data.phone.matches('^[6-9][0-9]{9}$'))
        );
      allow get: if true;
      allow list: if isStaff();
      // Staff move it along: new → ready → done (or cancelled).
      allow update: if (isStaff()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'history', 'note', 'updated', 'by', 'paid', 'bill']))
        // The farmer may cancel their own (they hold the id) while it is open.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelled'])
          && request.resource.data.status == 'cancelled'
          && resource.data.status in ['new', 'ready']
          && request.resource.data.cancelled == request.time);
      allow delete: if isOwner();
    }

    match /kendra_complaints/{id} {
      allow create: if request.resource.data.keys().hasOnly(['order', 'code', 'text', 'phone', 'lang', 'app', 'at'])
        && request.resource.data.order is string
        && request.resource.data.order.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.at == request.time;
      allow read: if isStaff();
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'note', 'by']);
      allow delete: if isOwner();
    }

    // ── Business Plan v2 (25 Oct 2026): owner only ─────────────────────
    // Processors (their rate formula, quality cuts, payment days), their
    // daily quotes and what they owe us; the licence / renewal calendar;
    // the plan's step tracker. Business secrets — no phone ever reads them.
    match /processors/{id} {
      allow read, write: if isOwner();
    }
    match /proc_quotes/{id} {
      allow read, write: if isOwner();
    }
    match /proc_pay/{id} {
      allow read, write: if isOwner();
    }
    match /compliance/{id} {
      allow read, write: if isOwner();
    }
    match /business/{doc} {
      allow read, write: if isOwner();
    }

    // A Play purchase token already used, by its sha256: one purchase opens
    // Plus for one login only. The server alone reads and writes it.
    match /plus_tokens/{key} {
      allow read, write: if false;
    }

    // ── Free Khalihan Plus, given by the owner (1 Nov 2026) ─────────────
    // A gift code: the owner makes it in Khalihan Admin (at most 10 for
    // people, plus the owner's own test phones) and sends the person its
    // link (khalihan-admin.web.app/gift/CODE, 16 Nov 2026 — the code box is
    // gone from the app: only those the owner picks get one); the link opens
    // the app and Plus opens there. `tier`: 'plus' or 'pro' (none = Plus).
    // The phone reads only the code typed into it (nobody but the owner can
    // list the codes) and ties it to itself once: the first phone to use a
    // code keeps it, until the owner frees it for a new phone. No mobile
    // number is kept here — the owner's name for the person, a random id
    // the phone made, the app version and when.
    match /plus_gifts/{code} {
      allow get: if true;
      allow list, delete: if isOwner();
      allow create: if isOwner()
        && code.matches('^[A-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['name', 'note', 'until', 'test', 'tier', 'by', 'at'])
        && request.resource.data.get('tier', 'plus') in ['plus', 'pro']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.test is bool;
      allow update: if (isOwner()
          && request.resource.data.keys().hasOnly(['name', 'note', 'until', 'test', 'tier', 'by', 'at', 'device', 'claimed', 'app'])
          && request.resource.data.get('tier', 'plus') in ['plus', 'pro'])
        // The phone's one write: claiming a code no phone holds yet.
        || (resource.data.get('device', '') == ''
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['device', 'claimed', 'app'])
          && request.resource.data.device is string
          && request.resource.data.device.matches('^[a-z0-9]{20}$')
          && request.resource.data.claimed == request.time
          && request.resource.data.app is string
          && request.resource.data.app.size() <= 20);
    }

    // ── Khalihan Admin ─────────────────────────────────────────────────
    match /staff/{email} {
      // Everyone on the team can see the team; only the owner changes it.
      allow read: if isStaff();
      allow write: if isOwner();
    }

    match /audit/{id} {
      // Every change made from Admin leaves one line here; nobody edits it.
      allow create: if isStaff()
        && request.resource.data.by == staffEmail()
        && request.resource.data.at == request.time;
      allow read: if isOwner();
      allow update, delete: if false;
    }

    // A reply waiting to be pushed to the farmer's phone: the alert job
    // (tools/admin_alerts.py) sends it at its next run, then deletes it.
    match /reply_queue/{id} {
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['dev', 'reply', 'by', 'at'])
        && request.resource.data.dev.matches('^[a-z0-9]{20}$')
        && request.resource.data.reply is string
        && request.resource.data.reply.size() <= 40
        && request.resource.data.by == staffEmail()
        && request.resource.data.at == request.time;
      allow read, update, delete: if false;
    }

    // ── Admin alerts on phones and computers (Admin 1.30, owner 18 Nov 2026,
    // "Part 2" approved 10:41) ──────────────────────────────────────────
    // One document per team member's phone or computer that gets alerts:
    // that browser's Firebase push address, whose it is, the kind of device.
    // Only that person and the owner see it; the server's alert job
    // (tools/admin_alerts.py, service account) reads all and sends.
    match /staff_devices/{id} {
      allow read: if isStaff() && (resource.data.email == staffEmail() || isOwner());
      allow create, update: if isStaff()
        && request.resource.data.email == staffEmail()
        && request.resource.data.keys().hasOnly(['email', 'token', 'kind', 'browser', 'app', 'tz', 'at', 'last_sent'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 20
        && request.resource.data.token.size() < 600;
      allow delete: if isStaff() && (resource.data.email == staffEmail() || isOwner());
    }
    // Each person's own choices: which alerts, quiet hours, time zone.
    match /staff_prefs/{email} {
      allow read: if isStaff() && (email == staffEmail() || isOwner());
      allow write: if isStaff() && email == staffEmail();
    }
    // The bell's list — written only by the alert job. Team alerts for
    // everyone on the team; the owner's own (Pro, launch counter) apart.
    match /alerts_team/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /alerts_owner/{id} {
      allow read: if isOwner();
      allow write: if false;
    }
    // "Send me a test alert": the job sends it at its next run, then deletes it.
    match /alert_requests/{id} {
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['email', 'kind', 'device', 'at'])
        && request.resource.data.email == staffEmail()
        && request.resource.data.kind == 'test'
        && request.resource.data.device is string
        && request.resource.data.device.size() <= 64
        && request.resource.data.at == request.time;
      allow read, update, delete: if false;
    }

    match /owner_stats/{doc} {
      // The app's numbers (downloads, active users, features used) — counts
      // only, written twice a day by the server (tools/owner_stats.py).
      // Only the owner reads them; staff and farmers never (10 Nov 2026).
      allow read: if isOwner();
      allow write: if false;
    }
  }
}
